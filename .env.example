# ---- Required ----
MONGODB_URI="mongodb://localhost:27017/voguevibe"   # or your MongoDB Atlas URI
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
ADMIN_EMAIL="you@example.com"        # this email becomes ADMIN when it registers/logs in

# ---- Server ----
PORT=3000
DEFAULT_COUNTRY_CODE="+91"           # used when a phone is typed as 10 digits
# CLIENT_ORIGIN="http://localhost:5173"  # only if frontend runs on a different origin

# ---- Email OTP (SMTP, e.g. Gmail with an App Password) ----
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="yourgmail@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM="VogueVibe <yourgmail@gmail.com>"

# ---- Phone OTP: choose ONE provider ----
SMS_PROVIDER="fast2sms"              # fast2sms | twilio
FAST2SMS_API_KEY=""
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM=""

# If SMTP / SMS are NOT configured and NODE_ENV != production, OTPs are
# printed in the server console (and shown on screen) so you can test.
